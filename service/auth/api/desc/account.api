syntax = "v1"

import (
	"user.api"
)

type LoginReq {
	Data string `json:"data"`
}

type RegisterReq {
	Data string `json:"data"`
}

type HasSuperAdminResp {
	Exists bool `json:"exists"`
}

type UserLoginInfoReq {
	UserId string `header:"user-id"`
}

type UserLoginInfoResp {
	UserLoginInfo
}

type UserLogoutReq {
	UserLoginInfoReq
}