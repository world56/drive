HTTP_ADDR=0.0.0.0:2000

# local/dev → 文本 concise；production → JSON
APP_ENV=local

REDIS_URL=redis://:your_password@127.0.0.1:6379/1

JWT_SECRET=replace_with_a_strong_secret

UPSTREAM_AUTH=http://127.0.0.1:2001
UPSTREAM_ASSET=http://127.0.0.1:2002
UPSTREAM_STATS=http://127.0.0.1:2003
UPSTREAM_STORAGE=http://127.0.0.1:2004
